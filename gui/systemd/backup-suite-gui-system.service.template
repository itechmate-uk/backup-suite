[Unit]
Description=Backup Suite GUI (system-wide, shared by the members of __GROUP__)
Documentation=https://github.com/itechmate-uk/backup-suite/blob/main/docs/GUI.md
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# A dedicated account without a shell or login. It reaches Backup Suite only
# through the control broker (it is in __GROUP__), like an admin's own GUI.
User=__USER__
Group=__GROUP__
WorkingDirectory=__GUI_DIR__
Environment=NODE_ENV=production
Environment=HOME=/var/lib/backup-suite-gui
Environment=BACKUP_SUITE_GUI_SYSTEM=1
Environment=BACKUP_SUITE_GUI_SOCKET=/run/backup-suite-gui/gui.sock
Environment=BACKUP_SUITE_GUI_SOCKET_GROUP=__GROUP__
Environment=BACKUP_SUITE_GUI_CONFIG_DIR=/var/lib/backup-suite-gui/config
Environment=BACKUP_SUITE_GUI_STATE_DIR=/var/lib/backup-suite-gui/state
ExecStart=__NODE__ __GUI_DIR__/server.js
Restart=on-failure
RestartSec=3
# The socket directory is shared with the group: its members tunnel to the socket.
RuntimeDirectory=backup-suite-gui
RuntimeDirectoryMode=0750
StateDirectory=backup-suite-gui
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
Nice=10
CPUQuota=50%
MemoryAccounting=yes
MemoryHigh=__MEMORY_HIGH__M
MemoryMax=__MEMORY_MAX__M
MemorySwapMax=32M
TasksMax=__TASKS_MAX__
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backup-suite-gui

[Install]
WantedBy=multi-user.target
